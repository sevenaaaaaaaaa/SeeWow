# ── Repository scope ─────────────────────────────────────────────
# Publishes the Flutter app (apps/seewow), its docs, screenshots and CI.
# The legacy SwiftUI workspace and unrelated local projects sharing this
# folder (Awake, prep scratch, build outputs) are not versioned.
/*
!/.gitignore
!/README.md
!/design.md
!/skins/
!/apps/
!/qa/
!/docs/
!/.github/

apps/seewow_prep/
docs/awake/
docs/screens/*
!docs/screens/flutter-*.png
qa/*/.artifacts/

# ── Flutter / Dart ──────────────────────────────────────────────
apps/seewow/.dart_tool/
apps/seewow/build/
apps/seewow/.flutter-plugins-dependencies
apps/seewow/.idea/
apps/seewow/*.iml
apps/seewow/coverage/

# Apple
apps/seewow/macos/Pods/
apps/seewow/macos/.symlinks/
apps/seewow/macos/Flutter/ephemeral/
apps/seewow/ios/Pods/
apps/seewow/ios/.symlinks/
apps/seewow/ios/Flutter/ephemeral/

# Android
apps/seewow/android/.gradle/
apps/seewow/android/build/
apps/seewow/android/local.properties

# Windows / Linux
apps/seewow/windows/flutter/ephemeral/
apps/seewow/linux/flutter/ephemeral/

# ── Local artifacts ─────────────────────────────────────────────
dist/
target/
.build/
DemoMedia/
DemoMusic/
.DS_Store
*.log

# ─── gh-ops 隐私闸门（本机自动生成；删掉这段就不再有仓库内可见的规则）───
# 依据：~/.qclaw/workspace/SOUL.md「Private things stay private. Period.」
# 这些内容永远不进仓库：密钥 / 令牌 / 服务器凭据 / 用户数据

# 密钥与证书
*.pem
*.key
*.p12
*.pfx
*.keystore
!debug.keystore
*.jks
*.mobileprovision
*.p8
id_rsa*
id_ed25519*
id_ecdsa*
.ssh/

# 环境与凭据
.env
.env.local
.env.*.local
secrets/
secrets.json
secrets.yaml
secrets.yml
credentials.json
DEPLOY-SECRETS*
*.session
.kiwivm.env

# 运行时数据与备份
data/*.db
data/*.db-shm
data/*.db-wal
*.sqlite
*.sqlite3
backup-*.tgz

# 本机杂项
.DS_Store
# ─── 闸门结束 ───
